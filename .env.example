# Copia este archivo a ".env" y ajusta los valores.

# --- Local (SQLite) ---
# DATABASE_URL=sqlite+aiosqlite:///./smarket_dev.db
# DATABASE_URL_SYNC=sqlite:///./smarket_dev.db

# --- Local / Docker MySQL ---
# DATABASE_URL=mysql+aiomysql://grocery_user:grocery_password@localhost:3306/grocery_db
# DATABASE_URL_SYNC=mysql+pymysql://grocery_user:grocery_password@localhost:3306/grocery_db

# --- PythonAnywhere MySQL ---
# El nombre de la DB en PA es tipo: nestorcarvacho$smarket
# El "$" en la URL debe ir como %24
DATABASE_URL=mysql+aiomysql://nestorcarvacho:TU_PASSWORD@nestorcarvacho.mysql.pythonanywhere-services.com/nestorcarvacho%24smarket
DATABASE_URL_SYNC=mysql+pymysql://nestorcarvacho:TU_PASSWORD@nestorcarvacho.mysql.pythonanywhere-services.com/nestorcarvacho%24smarket

# Secreto para firmar los JWT. Genera uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Origenes CORS. En produccion podes dejar "*" mientras uses Expo / app mobile.
CORS_ORIGINS=*
