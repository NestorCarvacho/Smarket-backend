# Copia este archivo a ".env" y ajusta los valores.

# URL de conexion async a MySQL (usada por la app en runtime)
DATABASE_URL=mysql+aiomysql://grocery_user:grocery_password@localhost:3306/grocery_db

# URL de conexion sync a MySQL (usada solo por Alembic para migraciones)
DATABASE_URL_SYNC=mysql+pymysql://grocery_user:grocery_password@localhost:3306/grocery_db

# Secreto para firmar los JWT. Genera uno propio, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Origenes permitidos por CORS (separados por coma). Usa "*" en desarrollo.
CORS_ORIGINS=*
