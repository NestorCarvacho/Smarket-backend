# Copia este archivo a ".env" y ajusta los valores.

# --- Local (SQLite) ---
# DATABASE_URL=sqlite+aiosqlite:///./smarket_dev.db
# DATABASE_URL_SYNC=sqlite:///./smarket_dev.db

# --- Render Postgres ---
# En el dashboard: Postgres → Connect → Internal Database URL
# Podes pegar la URL "postgresql://..." tal cual; el backend la adapta a asyncpg/psycopg.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
# DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST/DBNAME

# --- Local / Docker MySQL ---
# DATABASE_URL=mysql+aiomysql://grocery_user:grocery_password@localhost:3306/grocery_db
# DATABASE_URL_SYNC=mysql+pymysql://grocery_user:grocery_password@localhost:3306/grocery_db

JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=*

PUBLIC_BASE_URL=https://smarket-backend-vf3c.onrender.com

EXPOSE_RESET_CODES=true
MAX_FAILED_LOGIN_ATTEMPTS=3
RESET_CODE_EXPIRE_MINUTES=30
